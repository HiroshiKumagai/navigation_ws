Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 40
      Color: 160; 160; 164
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 1
    - Class: rviz_default_plugins/LaserScan
      Name: scan_front_left
      Enabled: true
      Topic:
        Value: /scan_front_left
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 85; 0
      Decay Time: 0
    - Class: rviz_default_plugins/LaserScan
      Name: scan_rear_right
      Enabled: true
      Topic:
        Value: /scan_rear_right
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 0; 170; 255
      Decay Time: 0
    - Class: rviz_default_plugins/Odometry
      Name: odom
      Enabled: true
      Topic:
        Value: /odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Keep: 1
      Shape:
        Value: Arrow
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 30
      X: 0
      Y: 0
Window Geometry:
  Width: 1400
  Height: 900
